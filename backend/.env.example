# ============================================================================
# LLM Gateway — environment configuration
# Copy to `.env` (root, for docker compose) and/or `backend/.env` (local dev).
# Never commit a filled-in .env.
# ============================================================================

# --- Application ---------------------------------------------------------------
APP_NAME="LLM Gateway"
ENVIRONMENT=development          # development | staging | production | test
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- Routing -----------------------------------------------------------------
DEFAULT_PROVIDER=openai          # openai | anthropic | gemini

# --- OpenAI / Azure OpenAI -------------------------------------------------
# OPENAI_MODE=native  -> uses api.openai.com with OPENAI_API_KEY
# OPENAI_MODE=azure   -> uses AZURE_OPENAI_ENDPOINT + api-version; the request
#                        `model` field is treated as the Azure deployment name.
OPENAI_MODE=native
OPENAI_API_KEY=
OPENAI_BASE_URL=                 # optional: OpenAI-compatible proxy base URL
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

AZURE_OPENAI_ENDPOINT=           # e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=         # default deployment when request `model` is blank

# --- Anthropic -----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_DEFAULT_MAX_TOKENS=1024   # Anthropic requires max_tokens; used when a request omits it

# --- Gemini ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60

# --- Reliability: retry / backoff / fallback --------------------------------
RETRY_MAX_ATTEMPTS=3                # attempts per provider (1 initial + N-1 retries)
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=8
RETRY_BACKOFF_MULTIPLIER=2
RETRY_JITTER=true
PROVIDER_ATTEMPT_TIMEOUT_SECONDS=90
FALLBACK_ENABLED=true
FALLBACK_CHAIN=["openai","anthropic","gemini"]   # JSON array; filtered to enabled providers
FALLBACK_ON_EXPLICIT_PROVIDER=true               # also fall through when a request names a provider

# --- PostgreSQL (Phase 4) -------------------------------------------------
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# --- Redis (Phase 6) ------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Dashboard admin auth (Phase 8) ------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
