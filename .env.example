# ============================================================================
# LLM Gateway — environment configuration
# Copy to `.env` (root, for docker compose) and/or `backend/.env` (local dev).
# Never commit a filled-in .env.
# ============================================================================

# --- Application ---------------------------------------------------------------
APP_NAME="LLM Gateway"
ENVIRONMENT=development          # development | staging | production | test
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- Routing -----------------------------------------------------------------
DEFAULT_PROVIDER=openai          # openai | anthropic | gemini

# --- OpenAI / Azure OpenAI -------------------------------------------------
# OPENAI_MODE=native  -> uses api.openai.com with OPENAI_API_KEY
# OPENAI_MODE=azure   -> uses AZURE_OPENAI_ENDPOINT + api-version; the request
#                        `model` field is treated as the Azure deployment name.
OPENAI_MODE=native
OPENAI_API_KEY=
OPENAI_BASE_URL=                 # optional: OpenAI-compatible proxy base URL
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

AZURE_OPENAI_ENDPOINT=           # e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=         # default deployment when request `model` is blank

# --- Anthropic -----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_DEFAULT_MAX_TOKENS=1024   # Anthropic requires max_tokens; used when a request omits it

# --- Gemini ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60

# --- Azure AI Foundry (Phase 11) -----------------------------------------
# The Azure AI Model Inference API (https://<resource>.services.ai.azure.com).
# DISTINCT from OPENAI_MODE=azure above: this is the unified /models inference
# surface, not Azure OpenAI. Set both KEY and ENDPOINT to enable the provider;
# add "azure_foundry" to FALLBACK_CHAIN to include it in routing.
AZURE_FOUNDRY_ENDPOINT=              # e.g. https://my-resource.services.ai.azure.com  (with or without /models)
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
AZURE_FOUNDRY_MODEL=gpt-4o-mini     # a deployment name on the Foundry resource
AZURE_FOUNDRY_TIMEOUT_SECONDS=60

# --- Reliability: retry / backoff / fallback --------------------------------
RETRY_MAX_ATTEMPTS=3                # attempts per provider (1 initial + N-1 retries)
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=8
RETRY_BACKOFF_MULTIPLIER=2
RETRY_JITTER=true
PROVIDER_ATTEMPT_TIMEOUT_SECONDS=90
FALLBACK_ENABLED=true
FALLBACK_CHAIN=["openai","anthropic","gemini"]   # JSON array; filtered to enabled providers
FALLBACK_ON_EXPLICIT_PROVIDER=true               # also fall through when a request names a provider

# --- PostgreSQL ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
USAGE_LOGGING_ENABLED=true          # write one `requests` row per gateway call

# --- Metrics -----------------------------------------------------------------
METRICS_ENABLED=true                # Prometheus exposition at GET /metrics
METRICS_TOKEN=                      # if set, /metrics needs `Authorization: Bearer <token>`

# --- FX (dashboard currency switch, display-only) ---------------------------
FX_ENABLED=true                     # fetch USD->INR from Frankfurter (ECB), cache 24h in Redis
FX_USD_INR_FALLBACK=87.5            # used when the fetch fails / FX_ENABLED=false

# Test suite points here (created alongside the main DB by docker compose):
# TEST_DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway_test
# Cost per request is computed from backend/pricing.yaml (a versioned, point-in-time
# snapshot — see README). No env var; edit the file and bump its `version`.

# --- Redis --------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Client API keys / rate limiting -----------------------------------
REQUIRE_API_KEY=false                # true -> reject requests without a valid Bearer key
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60     # used when a project row has no explicit limit
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANON_PER_MINUTE=120       # bucket for callers with no API key
RATE_LIMIT_FAIL_OPEN=true            # if Redis is unreachable, allow (vs. 500)

# --- Caching ---------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_NAMESPACE=cache:chat
SEMANTIC_CACHE_ENABLED=true          # auto-disables (exact-match only) with no embedding key
SEMANTIC_CACHE_THRESHOLD=0.95        # cosine similarity to count as a hit
SEMANTIC_CACHE_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=   # Azure only: embedding deployment name, if one exists

# --- Request limits ---------------------------------------------------------
MAX_MESSAGES_PER_REQUEST=256
MAX_PROMPT_CHARS=600000
MAX_REQUEST_BODY_BYTES=5000000       # oversized bodies get 413 before being read

# --- Dashboard admin auth -------------------------------------------------
# In ENVIRONMENT=production these must be real (>=32-char secret, non-default
# password) or the app refuses to start.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_ACCESS_TTL_SECONDS=900           # 15 min
JWT_REFRESH_TTL_SECONDS=604800       # 7 days
AUTH_COOKIE_SECURE=true              # set false for local plain-HTTP dev
AUTH_COOKIE_SAMESITE=lax             # lax | strict | none
BCRYPT_ROUNDS=12
